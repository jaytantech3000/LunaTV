<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>io.qzz.lunatv.local-service</string>
  <key>KeepAlive</key>
  <true/>
  <key>ProcessType</key>
  <string>Background</string>
  <key>ProgramArguments</key>
  <array>
    <string>/Library/Application Support/LunaTV Local Service/lunatv-server</string>
    <string>--host</string>
    <string>127.0.0.1</string>
    <string>--port</string>
    <string>8787</string>
    <string>--config-path</string>
    <string>/Library/Application Support/LunaTV Local Service/config.json</string>
    <string>--data-dir</string>
    <string>/Library/Application Support/LunaTV Local Service/data</string>
    <string>--sqlite-path</string>
    <string>/Library/Application Support/LunaTV Local Service/data/moontv-local-service.sqlite3</string>
  </array>
  <key>RunAtLoad</key>
  <true/>
  <key>StandardErrorPath</key>
  <string>/Library/Logs/LunaTV Local Service/stderr.log</string>
  <key>StandardOutPath</key>
  <string>/Library/Logs/LunaTV Local Service/stdout.log</string>
  <key>WorkingDirectory</key>
  <string>/Library/Application Support/LunaTV Local Service</string>
</dict>
</plist>
