{
  "name": "moontv",
  "version": "200.0.1",
  "private": true,
  "scripts": {
    "dev": "pnpm desktop:sync:version && pnpm gen:manifest && next dev -H 0.0.0.0",
    "dev:pwa": "ENABLE_PWA_DEV=true pnpm dev",
    "build": "pnpm desktop:sync:version && pnpm gen:manifest && next build",
    "desktop:prepare:sidecar": "node scripts/sync-desktop-sidecar.mjs",
    "desktop:prepare:sidecar:release": "node scripts/sync-desktop-sidecar.mjs --release",
    "desktop:sync:version": "node scripts/sync-desktop-version.mjs",
    "desktop:sync:updater-config": "node scripts/sync-updater-config.mjs",
    "desktop:dev:frontend": "node scripts/start-desktop-frontend-dev.mjs",
    "desktop:dev:bootstrap": "pnpm desktop:sync:version && node scripts/desktop-dev-bootstrap.mjs",
    "desktop:dev": "node scripts/desktop-dev-launcher.mjs",
    "desktop:build:frontend": "node scripts/build-desktop-frontend.mjs",
    "desktop:build": "pnpm desktop:sync:version && pnpm desktop:sync:updater-config && tauri build",
    "desktop:check": "pnpm desktop:sync:version && pnpm desktop:sync:updater-config && pnpm desktop:prepare:sidecar && cargo check --workspace",
    "desktop:test": "pnpm desktop:sync:version && pnpm desktop:prepare:sidecar && cargo test --workspace",
    "desktop:service": "cargo run -p moontv-local-service -- --port 8787",
    "download-site:data": "node scripts/export-download-site-data.mjs --output .download-site-build/releases.json",
    "download-site:build": "pnpm download-site:data && node scripts/build-download-site.mjs --data .download-site-build/releases.json --output download-site-dist",
    "preview:offline": "pnpm build && sh scripts/start-standalone-preview.sh",
    "start": "next start",
    "lint": "next lint",
    "lint:fix": "eslint src --fix && pnpm format",
    "lint:strict": "eslint --max-warnings=0 src",
    "typecheck": "tsc --noEmit --incremental false",
    "test:watch": "jest --watch",
    "test": "jest",
    "check:tauri-csp": "node scripts/check-tauri-csp.mjs",
    "format": "prettier -w .",
    "format:check": "prettier -c .",
    "gen:manifest": "node scripts/generate-manifest.js",
    "postbuild": "echo 'Build completed - sitemap generation disabled'",
    "prepare": "husky install"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/modifiers": "^9.0.0",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@headlessui/react": "^2.2.4",
    "@heroicons/react": "^2.2.0",
    "@tanstack/react-virtual": "^3.13.19",
    "@tauri-apps/api": "^2.11.0",
    "@tauri-apps/plugin-process": "2.3.1",
    "@tauri-apps/plugin-updater": "2.10.1",
    "@types/crypto-js": "^4.2.2",
    "@upstash/redis": "^1.25.0",
    "@vidstack/react": "^1.12.13",
    "artplayer": "^5.2.5",
    "bs58": "^6.0.0",
    "clsx": "^2.0.0",
    "crypto-js": "^4.2.0",
    "framer-motion": "^12.18.1",
    "he": "^1.2.0",
    "hls.js": "^1.6.10",
    "lucide-react": "^0.438.0",
    "media-icons": "^1.1.5",
    "next": "^14.2.23",
    "next-pwa": "^5.6.0",
    "next-themes": "^0.4.6",
    "qrcode": "^1.5.4",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-icons": "^5.4.0",
    "redis": "^4.6.7",
    "swiper": "^11.2.8",
    "tailwind-merge": "^2.6.0",
    "vidstack": "^0.6.15",
    "zod": "^3.24.1",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@commitlint/cli": "^16.3.0",
    "@commitlint/config-conventional": "^16.2.4",
    "@svgr/webpack": "^8.1.0",
    "@tailwindcss/forms": "^0.5.10",
    "@tauri-apps/cli": "^2.10.0",
    "@testing-library/jest-dom": "^5.17.0",
    "@testing-library/react": "^15.0.7",
    "@types/bs58": "^5.0.0",
    "@types/he": "^1.2.3",
    "@types/node": "24.0.3",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^19.1.6",
    "@types/testing-library__jest-dom": "^5.14.9",
    "@typescript-eslint/eslint-plugin": "^5.62.0",
    "@typescript-eslint/parser": "^5.62.0",
    "autoprefixer": "^10.4.20",
    "babel-loader": "^10.1.1",
    "cross-env": "^10.0.0",
    "eslint": "^8.57.1",
    "eslint-config-next": "^14.2.23",
    "eslint-config-prettier": "^8.10.0",
    "eslint-plugin-simple-import-sort": "^7.0.0",
    "eslint-plugin-unused-imports": "^2.0.0",
    "husky": "^7.0.4",
    "jest": "^27.5.1",
    "lint-staged": "^12.5.0",
    "next-router-mock": "^0.9.0",
    "postcss": "^8.5.1",
    "prettier": "^2.8.8",
    "prettier-plugin-tailwindcss": "^0.5.0",
    "tailwindcss": "^3.4.17",
    "typescript": "^4.9.5",
    "webpack-obfuscator": "^3.5.1"
  },
  "lint-staged": {
    "**/*.{js,jsx,ts,tsx}": [
      "eslint --max-warnings=0",
      "prettier -w"
    ],
    "**/*.{json,css,scss,md,webmanifest}": [
      "prettier -w"
    ]
  },
  "packageManager": "pnpm@10.14.0"
}
